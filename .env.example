# VulnFlux — configuração. Copiar para .env e fazer `chmod 600 .env`.
# Qualquer variável pode vir de um Docker secret: /run/secrets/vf_dd_token preenche VF_DD_TOKEN.

# --- Rede ------------------------------------------------------------------------
# Proxy de saída para a Internet, se o servidor não tiver acesso direto. Usado no build
# da imagem (apt, pip, gem) e em execução (WPScan, API e BD do WPScan).
# NO_PROXY tem de incluir o DefectDojo e os destinos internos.
# HTTP_PROXY=http://proxy.interno:3128
# HTTPS_PROXY=http://proxy.interno:3128
# NO_PROXY=localhost,127.0.0.1,host.docker.internal,.dominio.interno,defectdojo.dominio.interno
# Tag da imagem a usar do GHCR (latest = último commit no main)
# VF_IMAGE_TAG=latest

# --- Interface web -------------------------------------------------------------
VF_ADMIN_USER=admin
# obrigatório: sem password, o login fica bloqueado
VF_ADMIN_PASSWORD=
# vazio = gerada e guardada em /data/.secret_key
# VF_SECRET_KEY=
# false só para testes sem HTTPS
VF_COOKIE_SECURE=true
VF_SESSION_HOURS=12
VF_TIMEZONE=Europe/Lisbon
# IP do proxy reverso (NPM) para confiar em X-Forwarded-*. Obrigatório atrás de um proxy: sem ele,
# todos os pedidos parecem vir do proxy e 8 logins falhados bloqueiam toda a gente durante 15 min.
# O VulnFlux escreve um aviso no log com o IP a pôr aqui quando deteta o caso.
# VF_FORWARDED_ALLOW_IPS=172.17.0.1

# --- DefectDojo ----------------------------------------------------------------
VF_DD_URL=https://defectdojo.exemplo.pt
VF_DD_TOKEN=
VF_DD_ENGAGEMENT=VulnFlux
VF_DD_DEFAULT_PRODUCT_TYPE=Sites_PRD
VF_DD_VERIFY_TLS=true
# CA interna, se o DD usar certificado privado
# VF_DD_CA_BUNDLE=/data/ca/ca-interna.pem

# Ambientes sugeridos no formulário (= product types no DefectDojo)
VF_ENVIRONMENTS=Sites_PRD,Sites_TST,Apps_TST,Development

# --- Horários -----------------------------------------------------------------------
# Os horários por omissão (VF_*_CRON) estão publicados no repositório. Em produção, muda-os
# para valores teus: quem conhece a hora dos scans e das atualizações sabe quando agir.

# --- WPScan --------------------------------------------------------------------
# Uma ou várias chaves (separadas por vírgulas). O VulnFlux escolhe para cada scan a
# chave com mais pedidos restantes e, se uma esgotar a meio, repete com a seguinte.
VF_WPSCAN_API_TOKENS=
# Compatibilidade: uma chave isolada aqui também entra na rotação
# VF_WPSCAN_API_TOKEN=
# diário às 02:37 (formato cron, hora de Lisboa)
VF_WPSCAN_CRON=37 2 * * *
# hosts por lote. Um site gasta ~1 pedido + 1 por plugin/tema com dados na API;
# com chaves free (25/dia) conta com ~1-2 sites por chave. Ex.: 5 chaves -> 6 a 8
VF_WPSCAN_BATCH_SIZE=4
# uma chave abaixo disto não é usada em novos scans
VF_WPSCAN_MIN_QUOTA=5
VF_WPSCAN_TIMEOUT=1800
VF_WPSCAN_DISABLE_TLS_CHECKS=false
# true = importa "interesting findings" como Info
VF_WPSCAN_INCLUDE_INTERESTING=false
# O que o WPScan enumera (o 4.x sem -e não analisa plugins nem utilizadores):
# vp/vt plugins/temas vulneráveis, tt timthumbs, cb backups de configuração,
# dbe exports da BD, bf pastas de backup, u1-10 utilizadores com ID 1 a 10
VF_WPSCAN_ENUMERATE=vp,vt,tt,cb,dbe,bf,u1-10
# passive (só o HTML), mixed (HTML + localizações conhecidas) ou aggressive
VF_WPSCAN_PLUGINS_DETECTION=mixed
# Utilizadores enumerados viram um finding Low por site (com a lista de usernames)
VF_WPSCAN_INCLUDE_USERS=true
# VF_WPSCAN_EXTRA_ARGS=--random-user-agent --throttle 200
# partilhado: enumera os sites sem chave e pede as vulnerabilidades uma vez por plugin/tema/versão
#             (cache partilhada); cabe nas chaves gratuitas com dezenas de sites. Ver docs/wordpress.md
# por_site:   scan clássico com a chave em cada site (para uma chave paga)
VF_WPSCAN_MODE=partilhado
VF_WPSCAN_CACHE_HOURS=24
# Perfil do lote diário no modo partilhado: rapido (só o que a página revela, minutos por site),
# completo (também os ~1 500 plugins populares, lento) ou exaustivo (todos os plugins: horas por site)
VF_WPSCAN_SHARED_PROFILE=rapido
# Lote semanal com o perfil completo (vazio = desligado)
VF_WPSCAN_DEEP_CRON=37 3 * * 0
# Plugins vistos no último scan completo continuam a ser verificados nos rápidos durante N dias
VF_WPSCAN_CARRY_DAYS=30
# Deteção diária de quais hosts são WordPress (antes do lote)
VF_WP_DETECT_CRON=7 2 * * *
# Sites por lote no modo partilhado (0 = todos: a enumeração não gasta quota)
VF_WPSCAN_SHARED_BATCH_SIZE=0

# --- Vigilante de atualizações e alertas (ver docs/wordpress.md) ----------------
VF_WATCH_ENABLED=true
VF_WATCH_INTERVAL_MINUTES=15
# Pedidos WPScan por verificação para refrescar os componentes mais usados (só acima da reserva)
VF_WATCH_WPSCAN_REFRESH=3
VF_WATCH_WPSCAN_RESERVE=10
# Wordfence Intelligence (chave gratuita): vulnerabilidades novas, cruzadas com os plugins instalados
# VF_WATCH_WORDFENCE_TOKEN=
# Ferramentas do SOC vigiadas no GitHub (releases)
# VF_WATCH_GITHUB_REPOS=n8n-io/n8n,greenbone/gvmd,DefectDojo/django-DefectDojo,MISP/MISP
# VF_WATCH_GITHUB_TOKEN=
# Feeds RSS/Atom de avisos: Nome=https://...; Outro=https://...
# VF_WATCH_RSS_FEEDS=
# Email: destino geral e rotas por equipa (etiqueta "equipa:<nome>" no host)
# VF_WATCH_EMAIL_TO=soc@exemplo.pt
# VF_WATCH_ROUTES=web=web@exemplo.pt; infra=infra@exemplo.pt
# VF_WATCH_EMAIL_MIN_SEVERITY=info
# VF_SMTP_HOST=smtp.exemplo.pt
# VF_SMTP_PORT=587
# VF_SMTP_STARTTLS=true
# VF_SMTP_USER=
# VF_SMTP_PASSWORD=
# VF_SMTP_FROM=vulnflux@exemplo.pt
# Tickets: email (endereço do service desk) ou webhook (POST JSON; ex.: um workflow n8n que cria o ticket)
# VF_TICKET_MODE=webhook
# VF_TICKET_EMAIL=servicedesk@exemplo.pt
# VF_TICKET_WEBHOOK_URL=https://n8n.exemplo.pt/webhook/soc-ticket
# VF_TICKET_WEBHOOK_TOKEN=
# VF_TICKET_MIN_SEVERITY=high

# --- Greenbone -----------------------------------------------------------------
VF_GREENBONE_ENABLED=false
# dia 26 de cada mês às 01:13
VF_GREENBONE_CRON=13 1 26 * *
VF_GREENBONE_USER=orchestrator
VF_GREENBONE_PASSWORD=
VF_GREENBONE_CONCURRENCY=3
VF_GREENBONE_SCAN_TIMEOUT_HOURS=8
VF_GREENBONE_MIN_QOD=70
# h/m/l; acrescentar g para importar Log como Info
VF_GREENBONE_LEVELS=hml
VF_GREENBONE_MIN_NVTS=10000
VF_GREENBONE_MAX_FEED_AGE_DAYS=7
# Ciclo de vida on-demand (vazio = Greenbone sempre ligado)
# VF_GREENBONE_SSH_HOST=host.docker.internal
# puxa imagens/feeds novos antes de cada lote
VF_GREENBONE_UPDATE_BEFORE_SCAN=true
VF_GREENBONE_STOP_AFTER=true

# --- Prioridade por risco (KEV, EPSS, exploits) --------------------------------------
VF_RISK_ENABLED=true
VF_RISK_CRON=17 6 * * *
# Dias para corrigir P1,P2,P3,P4 (o prazo da CISA ganha se for antes)
VF_RISK_SLA_DAYS=7,30,90,180
# Fontes (vazio desliga; file:///caminho para um espelho local sem Internet)
# VF_RISK_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# VF_RISK_EPSS_URL=https://epss.empiricalsecurity.com/epss_scores-{date}.csv.gz
# VF_RISK_EXPLOITDB_URL=https://gitlab.com/exploit-database/exploitdb/-/raw/main/files_exploits.csv
# VF_RISK_METASPLOIT_URL=https://raw.githubusercontent.com/rapid7/metasploit-framework/master/db/modules_metadata_base.json
# VF_RISK_NUCLEI_URL=https://raw.githubusercontent.com/projectdiscovery/nuclei-templates/main/cves.json
# URL do DefectDojo para os links no browser, se diferente de VF_DD_URL
# VF_DD_PUBLIC_URL=https://defectdojo.exemplo.pt

# --- Portal SOC ------------------------------------------------------------------------
# Ativa GET /api/status (lido pelo Portal SOC). Vazio = desligado.
# VF_STATUS_TOKEN=

# --- SIEM ------------------------------------------------------------------------------
# Ativa GET /api/exposure e /api/events (lidos pelo SIEM). Vazio = desligados.
# Usa um valor diferente do VF_STATUS_TOKEN: o portal não precisa da lista de exposição.
# VF_EXPOSURE_TOKEN=

# --- Gates -----------------------------------------------------------------------
# queda >50% nos findings => não fecha findings antigos
VF_GATE_DROP_THRESHOLD=0.5
VF_GATE_DROP_MIN_PREVIOUS=5

# --- Manutenção ------------------------------------------------------------------
VF_RETENTION_DAYS=180
# VF_LOG_LEVEL=INFO
