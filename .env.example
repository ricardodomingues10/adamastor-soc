# VulnFlux — configuração. Copiar para .env e fazer `chmod 600 .env`.
# Qualquer variável pode vir de um Docker secret: /run/secrets/vf_dd_token preenche VF_DD_TOKEN.

# --- Interface web -------------------------------------------------------------
VF_ADMIN_USER=admin
# obrigatório: sem password, o login fica bloqueado
VF_ADMIN_PASSWORD=
# vazio = gerada e guardada em /data/.secret_key
# VF_SECRET_KEY=
# false só para testes sem HTTPS
VF_COOKIE_SECURE=true
VF_SESSION_HOURS=12
VF_TIMEZONE=Europe/Lisbon
# IP do proxy (NPM) para confiar em X-Forwarded-*
# VF_FORWARDED_ALLOW_IPS=172.17.0.1

# --- DefectDojo ----------------------------------------------------------------
VF_DD_URL=https://defectdojo.exemplo.pt
VF_DD_TOKEN=
VF_DD_ENGAGEMENT=VulnFlux
VF_DD_DEFAULT_PRODUCT_TYPE=Sites_Publicos_PRD
VF_DD_VERIFY_TLS=true
# CA interna, se o DD usar certificado privado
# VF_DD_CA_BUNDLE=/data/ca/ca-interna.pem

# Ambientes sugeridos no formulário (= product types no DefectDojo)
VF_ENVIRONMENTS=Sites_Publicos_PRD,Sites_Publicos_TST,Apps_Publicas_Jogos_TST,Development

# --- WPScan --------------------------------------------------------------------
VF_WPSCAN_API_TOKEN=
# diário às 02:37 (formato cron, hora de Lisboa)
VF_WPSCAN_CRON=37 2 * * *
# hosts por lote (plano free: 25 pedidos/dia)
VF_WPSCAN_BATCH_SIZE=4
# abaixo disto não começa novos scans
VF_WPSCAN_MIN_QUOTA=5
VF_WPSCAN_TIMEOUT=1800
VF_WPSCAN_DISABLE_TLS_CHECKS=false
# true = importa "interesting findings" como Info
VF_WPSCAN_INCLUDE_INTERESTING=false
# VF_WPSCAN_EXTRA_ARGS=--random-user-agent --throttle 200

# --- Greenbone -----------------------------------------------------------------
VF_GREENBONE_ENABLED=false
# dia 26 de cada mês às 01:13
VF_GREENBONE_CRON=13 1 26 * *
VF_GREENBONE_USER=orchestrator
VF_GREENBONE_PASSWORD=
VF_GREENBONE_CONCURRENCY=3
VF_GREENBONE_SCAN_TIMEOUT_HOURS=8
VF_GREENBONE_MIN_QOD=70
# h/m/l; acrescentar g para importar Log como Info
VF_GREENBONE_LEVELS=hml
VF_GREENBONE_MIN_NVTS=10000
VF_GREENBONE_MAX_FEED_AGE_DAYS=7
# Ciclo de vida on-demand (vazio = Greenbone sempre ligado)
# VF_GREENBONE_SSH_HOST=host.docker.internal
# puxa imagens/feeds novos antes de cada lote
VF_GREENBONE_UPDATE_BEFORE_SCAN=true
VF_GREENBONE_STOP_AFTER=true

# --- Gates -----------------------------------------------------------------------
# queda >50% nos findings => não fecha findings antigos
VF_GATE_DROP_THRESHOLD=0.5
VF_GATE_DROP_MIN_PREVIOUS=5

# --- Manutenção ------------------------------------------------------------------
VF_RETENTION_DAYS=180
# VF_LOG_LEVEL=INFO
