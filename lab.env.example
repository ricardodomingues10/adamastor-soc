# Ambiente de laboratório (compose.lab.yaml). O scripts/lab.sh copia isto para .env.lab
# e gera as passwords/segredos marcados com GERAR. Preenche só as chaves WPScan.

# --- Obrigatório ------------------------------------------------------------------
# Uma ou várias chaves WPScan, separadas por vírgulas
VF_WPSCAN_API_TOKENS=

# --- Gerado automaticamente ------------------------------------------------------
VF_ADMIN_USER=admin
VF_ADMIN_PASSWORD=GERAR
GB_ADMIN_USER=orchestrator
GB_ADMIN_PASSWORD=GERAR
DD_ADMIN_PASSWORD=GERAR
DD_SECRET_KEY=GERAR
DD_CREDENTIAL_AES_256_KEY=GERAR
DD_DATABASE_PASSWORD=GERAR
SP_ADMIN_USER=admin
SP_ADMIN_PASSWORD=GERAR
# Lido pelo Portal SOC em http://vulnflux:8080/api/status
VF_STATUS_TOKEN=GERAR
# Lido pelo Portal SOC em http://atalaia-web:8088/api/status (./scripts/lab.sh atalaia up)
ATALAIA_STATUS_TOKEN=GERAR

# --- Opcional ---------------------------------------------------------------------
# Portas no Windows/WSL
VF_PORT=8080
DD_PORT=8081
PORTAL_PORT=8090
ATALAIA_PORT=8088
# Proxy de saída, se necessário (build e execução)
# HTTP_PROXY=http://proxy:3128
# HTTPS_PROXY=http://proxy:3128
# NO_PROXY=localhost,127.0.0.1,dd-nginx,.dominio.interno

# Afinação para o laboratório: lotes pequenos e Greenbone com um scan de cada vez
VF_WPSCAN_BATCH_SIZE=2
VF_GREENBONE_CONCURRENCY=1
VF_GREENBONE_MAX_FEED_AGE_DAYS=30
VF_DD_DEFAULT_PRODUCT_TYPE=Lab
VF_ENVIRONMENTS=Lab,Sites_Publicos_PRD,Sites_Publicos_TST,Apps_Publicas_Jogos_TST,Development
