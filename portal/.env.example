# Portal SOC — configuração do processo. Os serviços monitorizados estão no portal.yaml.

SP_ADMIN_USER=admin
SP_ADMIN_PASSWORD=
# Atrás de HTTPS deixar true. false só para testes locais em http://
SP_COOKIE_SECURE=true

# Intervalo entre verificações (segundos)
SP_POLL_SECONDS=60
# Certificados internos dos serviços: caminho para a CA (montada em /run/secrets, por ex.)
# SP_CA_BUNDLE=/run/secrets/ca-interna.pem

# Versões mais recentes (GitHub). Token opcional, só leitura de repositórios públicos.
# SP_GITHUB_TOKEN=

# Alertas quando um serviço cai ou recupera: POST JSON {"text": "..."} (Teams/Slack/Mattermost)
# SP_WEBHOOK_URL=
# SP_WEBHOOK_LEVEL=fail

# Token para /api/summary (SIEM, scripts). Vazio = só com sessão.
# SP_API_TOKEN=

# Proxy de saída
# HTTPS_PROXY=http://proxy:3128
# NO_PROXY=localhost,127.0.0.1,.dominio.interno
